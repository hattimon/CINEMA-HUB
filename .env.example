# Adres i port panelu w sieci lokalnej. Bez przekierowania portu w routerze.
LAN_BIND=0.0.0.0
APP_PORT=8090
APP_IMAGE=ghcr.io/hattimon/cinema-hub:1.3.15
# Ustaw własne hasło przed pierwszym uruchomieniem nowego kontenera.
INITIAL_ADMIN_PASSWORD=
# Cookie Secure włącz tylko za reverse proxy HTTPS.
COOKIE_SECURE=false
# Opcjonalna publiczna baza adresów reverse proxy, np. https://kino.example.org
# PUBLIC_ORIGIN=
