FROM node:22-bookworm-slim AS frontend
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src
RUN npm run build

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium xvfb x11vnc novnc websockify ffmpeg rclone tini gosu ca-certificates fonts-liberation && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production PORT=8090 DISPLAY=:99 CHROMIUM_PATH=/usr/bin/chromium DATA_DIR=/data COOKIE_SECURE=true BROWSER_SERIAL=true BROWSER_CLOSE_AFTER_WORK=true
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY server ./server
COPY ops/start.sh ops/railway-start.sh ./ops/
COPY releases/CinemaHub-Magcubic-L018-v1.3.2.apk ./client.apk
COPY --from=frontend /app/dist ./dist
EXPOSE 8090
ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["sh", "/app/ops/railway-start.sh"]
