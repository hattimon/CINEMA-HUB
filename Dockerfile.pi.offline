# Reuse the installed ARM64 runtime only when its complete dependency lock matches.
ARG DEPENDENCY_IMAGE=cinema-hub:rpi
FROM ${DEPENDENCY_IMAGE}
USER root
WORKDIR /app
ENV BROWSER_SERIAL=true BROWSER_CLOSE_AFTER_WORK=true
COPY package-lock.json /tmp/cinema-next-lock.json
RUN node -e "const fs=require('node:fs');const load=path=>{const lock=JSON.parse(fs.readFileSync(path));delete lock.version;delete lock.packages[''].version;return JSON.stringify(lock)};if(load('/app/package-lock.json')!==load('/tmp/cinema-next-lock.json'))throw Error('Offline dependencies differ from this release');fs.unlinkSync('/tmp/cinema-next-lock.json')"
COPY package*.json ./
RUN rm -rf /app/server /app/dist
COPY server ./server
COPY ops/start.sh ./ops/start.sh
COPY dist ./dist
ENV NODE_ENV=production PORT=8090 DISPLAY=:99 CHROMIUM_PATH=/usr/bin/chromium DATA_DIR=/data
LABEL org.opencontainers.image.version="1.3.3"
USER node
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD node -e "fetch('http://127.0.0.1:8090/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["sh", "/app/ops/start.sh"]
